# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=3001

# MongoDB Configuration
MONGO_URI=your_mongodb_atlas_connection_string_here
# Example: mongodb+srv://username:password@cluster.mongodb.net/

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Frontend URLs (add your deployed frontend URLs for CORS)
ADMIN_FRONTEND_URL=https://your-admin-frontend.netlify.app
USER_FRONTEND_URL=https://your-user-frontend.netlify.app

# Backend Base URL (for image URLs and file serving)
BASE_URL=https://tiros-backend.onrender.com

# PhonePe (required for payment initiation and verification)
# PHONEPE_CLIENT_ID=your_client_id_here
# PHONEPE_CLIENT_SECRET=your_client_secret_here
# PHONEPE_CLIENT_VERSION=1
# PHONEPE_ENV=SANDBOX
# PHONEPE_REDIRECT_URL=https://topshot.co/checkout/return
# PHONEPE_WEBHOOK_USERNAME=olivia19
# PHONEPE_WEBHOOK_PASSWORD=olivia123
